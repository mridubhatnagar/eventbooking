meta {
  name: Create Main Event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "name": "Demo Concert",
    "event_date": "2026-12-01",
    "hour": 6,
    "minute": 0,
    "meridiem": "PM",
    "venue": "Main Hall",
    "city": "Bengaluru",
    "capacity": 50,
    "price": "25.00"
  }
}

vars:post-response {
  eventId1: res.body.data.id
}
