  token: {{organizerToken}}
}

body:json {
  {
    "venue": "Main Hall (Renovated)"
  }
}

docs {
  Triggers the Event Update Notification background task. Nothing to check
  here — watch `docker compose logs -f worker` for the `[notification] ...`
  line while recording.
}
