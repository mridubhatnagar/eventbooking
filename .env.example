# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and protected from Claude's Read/Edit/Write.

DATABASE_URL=postgresql://eventbooking:eventbooking@db:5432/eventbooking
JWT_SECRET_KEY=change-me-to-a-random-32-byte-secret
JWT_EXPIRY_DAYS=2

REDIS_URL=redis://redis:6379/0

RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=change-me

MOCK_TRIGGER_API_KEY=change-me
WEB_BASE_URL=http://app:5000
RAZORPAY_MOCK_BASE_URL=http://mock-razorpay:5000
PAYMENT_GATEWAY_DELAY_SECONDS=5

# HTTP Basic Auth for the Flower dashboard (celery monitoring, :5555).
# Read directly by Flower itself (not app/config.py) — comma-separated
# user:pass pairs. Without this, Flower's own dashboard can't load task
# data (its REST API 401s unless this or FLOWER_UNAUTHENTICATED_API is set).
FLOWER_BASIC_AUTH=change-me:change-me
